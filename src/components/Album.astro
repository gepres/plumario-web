---
import { CATEGORIES, HABITATS, LOCKED_BIRDS, SAMPLE_BIRDS, TOTAL_BIRDS } from '../data/site';
import Sticker from './Sticker.astro';

// La página mezcla la muestra en color con algunas casillas en sombra, como un álbum a medio llenar.
const shadows = LOCKED_BIRDS.filter((_, index) => index % 55 === 20).slice(0, 5);
const cells = [
  ...SAMPLE_BIRDS.map((bird) => ({ bird, locked: false })),
  ...shadows.map((bird) => ({ bird, locked: true })),
].sort((a, b) => a.bird.number - b.bird.number);
const locked = TOTAL_BIRDS - SAMPLE_BIRDS.length;
---

<section id="album" class="album" aria-labelledby="album-title" data-album>
  <div class="album__head">
    <h2 id="album-title" class="section-title">{SAMPLE_BIRDS.length} aves a la vista. {locked} por descubrir.</h2>
    <p class="lead">
      Esta es una muestra del álbum. Las demás solo aparecen en la app: cada una se desbloquea con una foto tuya.
    </p>
  </div>

  <ul class="album__grid" data-album-grid>
    {
      cells.map(({ bird, locked: isLocked }) => (
        <li>
          {isLocked ? (
            <Sticker bird={bird} resolution={160} empty />
          ) : (
            <button
              type="button"
              class="album__bird"
              data-bird={bird.id}
              data-number={bird.number}
              data-name={bird.name}
              data-scientific={bird.scientificName}
              data-family={bird.family}
              data-habitat-name={HABITATS[bird.habitat].name}
              data-category={CATEGORIES[bird.category].name}
              data-tint={HABITATS[bird.habitat].tint}
              data-endemic={bird.endemic ? '' : undefined}
              data-threatened={bird.threatened ? '' : undefined}
              aria-haspopup="dialog"
            >
              <Sticker bird={bird} resolution={160} />
            </button>
          )}
        </li>
      ))
    }
    <li>
      <a class="album__locked" href="#lista">
        <strong>+{locked}</strong>
        <span>en la app</span>
      </a>
    </li>
  </ul>

  <dialog class="bird-dialog" aria-labelledby="bird-dialog-name" data-bird-dialog data-lenis-prevent>
    <div class="bird-dialog__art" data-dialog-art>
      <img src="data:," alt="" width="320" height="320" data-dialog-image />
    </div>
    <div class="bird-dialog__body">
      <h3 id="bird-dialog-name" data-dialog-name></h3>
      <p class="scientific" translate="no" data-dialog-scientific></p>
      <dl>
        <div><dt>N.º en el álbum</dt><dd data-dialog-number></dd></div>
        <div><dt>Hábitat</dt><dd data-dialog-habitat></dd></div>
        <div><dt>Cromo</dt><dd data-dialog-category></dd></div>
        <div><dt>Familia</dt><dd data-dialog-family></dd></div>
      </dl>
      <p class="bird-dialog__note" data-dialog-note></p>
      <div class="bird-dialog__actions">
        <a class="button" href="#lista" data-dialog-cta>Avísame cuando salga</a>
        <button type="button" class="bird-dialog__close" data-dialog-close>Cerrar</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import '../scripts/album';
</script>
